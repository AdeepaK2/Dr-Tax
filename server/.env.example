# Copy to .env and fill in.
# A long random secret. The app sends it in the x-api-key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=
# Local MongoDB, Docker (see docker-compose.yml), or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/drtax
PORT=3000
