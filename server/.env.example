# Copy to .env and fill in.
# A long random secret that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# (Older setups used API_KEY; it still works as a fallback.)
JWT_SECRET=
# Local MongoDB, Docker (see docker-compose.yml), or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/drtax
PORT=3000
